# ==============================================================================
# ENVIRONMENT KEYS TEMPLATE (.env.example)
# Copy file này thành `.env` và điền giá trị thực tế
# ==============================================================================

# 1. 🐙 GitHub Personal Access Token (PAT)
GITHUB_TOKEN=your_github_personal_access_token_here

# 2. ⚡ Cloudflare Account API Token & Account ID
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 3. 🤗 Hugging Face User Access Tokens
HF_TOKEN=your_huggingface_full_token_here
HF_TOKEN_FINEGRAINED=your_huggingface_finegrained_token_here

# 4. 🗄️ Supabase Admin Service Role Key & Database Direct URL
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=your_supabase_postgres_direct_url_here

# 5. 🚀 Vercel Account OIDC Token
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here

# 6. 📲 Appetize.io Account Token
APPETIZE_API_TOKEN=your_appetize_api_token_here
